{
  "schema_version": 1,
  "id": "bellpad",
  "name": "BellPad",
  "game": "Animal Crossing (GameCube) via the ACGC decompilation and Aurora",
  "kind": "decomp-patches",
  "status": "experimental",
  "inputs": [
    {
      "type": "gamecube-disc",
      "formats": [
        "iso",
        "gcm"
      ],
      "when": "in-app",
      "description": "Your own supported Animal Crossing raw ISO/GCM, chosen in the app through Files. The build does not read it."
    }
  ],
  "targets": {
    "ios": {
      "hosts": {
        "macos-arm64": "experimental"
      },
      "output": "ipa",
      "check": "ipa",
      "steps": [
        {
          "stage": "dependencies",
          "command": [
            "git",
            "-C",
            "{repo}",
            "submodule",
            "update",
            "--init",
            "--recursive"
          ]
        },
        {
          "stage": "compile",
          "command": [
            "/bin/sh",
            "{repo}/scripts/build-aurora-game-ios-device.sh"
          ]
        },
        {
          "stage": "package",
          "command": [
            "/bin/sh",
            "{repo}/scripts/package-unsigned-ipa.sh"
          ],
          "env": {
            "BELLPAD_UNSIGNED_IPA_OUTPUT": "{output}"
          }
        }
      ]
    },
    "macos": {
      "hosts": {
        "macos-arm64": "experimental"
      },
      "output": "zip",
      "check": "none",
      "steps": [
        {
          "stage": "dependencies",
          "command": [
            "git",
            "-C",
            "{repo}",
            "submodule",
            "update",
            "--init",
            "--recursive"
          ]
        },
        {
          "stage": "compile",
          "command": [
            "/bin/sh",
            "{repo}/scripts/build-playable-macos-app.sh"
          ]
        },
        {
          "stage": "sign",
          "command": [
            "/usr/bin/codesign",
            "--force",
            "--deep",
            "--sign",
            "-",
            "{repo}/source/acgc-64bit/pc/build-bellpad-app/bin/Bellpad.app"
          ]
        },
        {
          "stage": "package",
          "command": [
            "/usr/bin/ditto",
            "-c",
            "-k",
            "--keepParent",
            "{repo}/source/acgc-64bit/pc/build-bellpad-app/bin/Bellpad.app",
            "{output}"
          ]
        }
      ]
    }
  },
  "requirements": {
    "disk_gb": 10,
    "tools": [
      {
        "name": "git",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "cmake",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "ninja",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "python3",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "rg",
        "version_args": [
          "--version"
        ],
        "player": true,
        "note": "Install ripgrep for the packaging checks: brew install ripgrep"
      },
      {
        "name": "xcodebuild",
        "version_args": [
          "-version"
        ],
        "note": "Install Xcode and its iOS platform"
      }
    ]
  },
  "publication": {
    "public_binaries": false,
    "reason": "The app is compiled from the Animal Crossing decompilation; public releases are source only."
  }
}
