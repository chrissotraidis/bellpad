diff --git a/pc/src/pc_dvd.c b/pc/src/pc_dvd.c
index 1e4c88c..5c92708 100644
--- a/pc/src/pc_dvd.c
+++ b/pc/src/pc_dvd.c
@@ -197,0 +198,2 @@ s32 DVDReadPrio(void* fileInfo, void* buf, s32 length, s32 offset, s32 prio) {
+    u32 file_length = *dvd_fi_length(fileInfo);
+    u32 readable;
@@ -199,0 +202,9 @@ s32 DVDReadPrio(void* fileInfo, void* buf, s32 length, s32 offset, s32 prio) {
+    if (length < 0 || offset < 0 || (u32)offset > file_length) {
+        return -1;
+    }
+
+    readable = (u32)length;
+    if (readable > file_length - (u32)offset) {
+        readable = file_length - (u32)offset;
+    }
+
@@ -203,3 +214,7 @@ s32 DVDReadPrio(void* fileInfo, void* buf, s32 length, s32 offset, s32 prio) {
-        if (pc_disc_read(base + (u32)offset, buf, (u32)length))
-            return length;
-        return -1;
+        if (readable > 0 && !pc_disc_read(base + (u32)offset, buf, readable)) {
+            return -1;
+        }
+        if (readable < (u32)length) {
+            memset((u8*)buf + readable, 0, (u32)length - readable);
+        }
+        return length;
@@ -213 +228,7 @@ s32 DVDReadPrio(void* fileInfo, void* buf, s32 length, s32 offset, s32 prio) {
-    return (s32)fread(buf, 1, length, fp);
+    if (readable > 0 && fread(buf, 1, readable, fp) != readable) {
+        return -1;
+    }
+    if (readable < (u32)length) {
+        memset((u8*)buf + readable, 0, (u32)length - readable);
+    }
+    return length;
