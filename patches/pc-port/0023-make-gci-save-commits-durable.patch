+static int pc_save_flush_file(FILE* fp) {
+    if (fflush(fp) != 0) {
+        return FALSE;
+    }
+#ifdef _WIN32
+    return _commit(_fileno(fp)) == 0;
+#else
+    return fsync(fileno(fp)) == 0;
+#endif
+}
+
+/* Persist the rename and backup rotation metadata after the new GCI is in
+ * place. A failure here cannot safely roll back an already-visible save, so
+ * report it while leaving the successfully renamed file available. */
+static void pc_save_sync_parent_directory(const char* path) {
+#ifdef _WIN32
+    (void)path;
+#else
+    char directory[300];
+    const char* slash = strrchr(path, '/');
+    size_t length;
+    int fd;
+
+    if (slash == NULL) {
+        strcpy(directory, ".");
+    } else {
+        length = (size_t)(slash - path);
+        if (length == 0) length = 1;
+        if (length >= sizeof(directory)) {
+            OSReport("[PC] GCI save: parent path is too long to sync: %s\n", path);
+            return;
+        }
+        memcpy(directory, path, length);
+        directory[length] = '\0';
+    }
+
+    fd = open(directory, O_RDONLY);
+    if (fd < 0) {
+        OSReport("[PC] GCI save: could not open parent directory for sync: %s\n", directory);
+        return;
+    }
+    if (fsync(fd) != 0) {
+        OSReport("[PC] GCI save: could not sync parent directory: %s\n", directory);
+    }
+    close(fd);
+#endif
+}
