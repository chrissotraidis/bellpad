diff --git a/pc/include/pc_apple.h b/pc/include/pc_apple.h
index aa24f0e..d9c5618 100644
--- a/pc/include/pc_apple.h
+++ b/pc/include/pc_apple.h
@@ -18,6 +18,18 @@ int pc_apple_resource_path(const char* relative_path, char* out_path,
  * run may set BELLPAD_DATA_HOME to an isolated absolute path. */
 int pc_apple_prepare_data_directory(void);
 
+/* Remembers the image the player chose so later launches do not ask again.
+ * The reference is stored inside the prepared data directory as an alias, so
+ * a renamed or moved image still resolves. No retail data is copied. */
+int pc_apple_store_disc_path(const char* path);
+
+/* Resolves the remembered image without presenting UI. Returns 0 when nothing
+ * is remembered or the reference no longer resolves. */
+int pc_apple_load_disc_path(char* out_path, size_t capacity);
+
+/* Drops the remembered reference. */
+void pc_apple_forget_disc_path(void);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/pc/src/pc_apple.m b/pc/src/pc_apple.m
index 261621c..a0310d0 100644
--- a/pc/src/pc_apple.m
+++ b/pc/src/pc_apple.m
@@ -79,3 +79,60 @@ int pc_apple_prepare_data_directory(void) {
         return file_path != NULL && chdir(file_path) == 0;
     }
 }
+
+/* Relative to the prepared data directory, like settings.ini and save/. */
+static NSString* const kDiscReferenceFile = @"disc.alias";
+
+int pc_apple_store_disc_path(const char* path) {
+    if (path == NULL || path[0] == '\0') return 0;
+
+    @autoreleasepool {
+        NSURL* url = [NSURL fileURLWithFileSystemRepresentation:path
+                                                    isDirectory:NO
+                                                  relativeToURL:nil];
+        if (url == nil) return 0;
+
+        NSData* reference = [url bookmarkDataWithOptions:0
+                          includingResourceValuesForKeys:nil
+                                           relativeToURL:nil
+                                                   error:NULL];
+        if (reference == nil) return 0;
+
+        return [reference writeToFile:kDiscReferenceFile
+                              options:NSDataWritingAtomic
+                                error:NULL] ? 1 : 0;
+    }
+}
+
+int pc_apple_load_disc_path(char* out_path, size_t capacity) {
+    if (out_path == NULL || capacity == 0) return 0;
+    out_path[0] = '\0';
+
+    @autoreleasepool {
+        NSData* reference = [NSData dataWithContentsOfFile:kDiscReferenceFile];
+        if (reference == nil) return 0;
+
+        BOOL stale = NO;
+        NSURL* url = [NSURL URLByResolvingBookmarkData:reference
+                                               options:NSURLBookmarkResolutionWithoutUI
+                                         relativeToURL:nil
+                                   bookmarkDataIsStale:&stale
+                                                 error:NULL];
+        if (url == nil) return 0;
+
+        const char* resolved = url.fileSystemRepresentation;
+        if (resolved == NULL || strlen(resolved) >= capacity) return 0;
+        strcpy(out_path, resolved);
+
+        /* The image moved; rewrite the reference from its current location. */
+        if (stale) pc_apple_store_disc_path(resolved);
+        return 1;
+    }
+}
+
+void pc_apple_forget_disc_path(void) {
+    @autoreleasepool {
+        [NSFileManager.defaultManager removeItemAtPath:kDiscReferenceFile
+                                                 error:NULL];
+    }
+}
