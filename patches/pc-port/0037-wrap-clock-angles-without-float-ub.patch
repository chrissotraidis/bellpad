diff --git a/src/game/m_time.c b/src/game/m_time.c
--- a/src/game/m_time.c
+++ b/src/game/m_time.c
@@ -440,8 +440,13 @@ extern void mTM_time_init() {
 
   // Calculate rad_hour and rad_min values for clock hands
   temp = Common_Get(time.rtc_time.sec) + Common_Get(time.rtc_time.min) * mTM_SECONDS_IN_MINUTE;
+#ifdef TARGET_PC
+  Common_Set(time.rad_min, (u16)((temp / mTM_SECONDS_IN_HOUR_F) * SHORT_ANGLE_MAX));
+  Common_Set(time.rad_hour, (u16)(((temp + (Common_Get(time.rtc_time.hour) % 12) * mTM_SECONDS_IN_HOUR) / mTM_SECONDS_IN_HALFDAY_F) * SHORT_ANGLE_MAX));
+#else
   Common_Set(time.rad_min, (temp / mTM_SECONDS_IN_HOUR_F) * SHORT_ANGLE_MAX);
   Common_Set(time.rad_hour, ((temp + Common_Get(time.rtc_time.hour) * mTM_SECONDS_IN_HOUR) / mTM_SECONDS_IN_HALFDAY_F) * SHORT_ANGLE_MAX);
+#endif
 }
 
