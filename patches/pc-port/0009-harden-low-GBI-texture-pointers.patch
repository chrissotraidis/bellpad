diff --git a/pc/src/pc_gx_texture.c b/pc/src/pc_gx_texture.c
--- a/pc/src/pc_gx_texture.c
+++ b/pc/src/pc_gx_texture.c
@@ -2,0 +3 @@
+#include "pc_gbi_ptr.h"
@@ -10,0 +12,26 @@
+/* For this port's supported 64-bit layouts, game pointers come from mapped
+ * regions above the low 4 GiB. Recover a legacy truncated GBI pointer only
+ * when its low bits identify a byte inside the known game arena or executable
+ * image. Reject other values before texture hashing or decoding dereferences
+ * them. */
+static void* pc_gx_resolve_gbi_ptr(void* data) {
+#if UINTPTR_MAX > 0xFFFFFFFFu
+    uintptr_t raw = (uintptr_t)data;
+    if (raw != 0 && raw <= 0xFFFFFFFFu) {
+        uintptr_t recovered = pc_gbi_recover_ptr((unsigned int)raw);
+        if (recovered == raw) {
+            static int warned = 0;
+            if (!warned) {
+                fprintf(stderr,
+                        "[PC] Rejected unrecoverable low GBI texture pointer %p\n",
+                        data);
+                warned = 1;
+            }
+            return NULL;
+        }
+        return (void*)recovered;
+    }
+#endif
+    return data;
+}
+
@@ -206 +233 @@
-    o->image_ptr = image_ptr;
+    o->image_ptr = pc_gx_resolve_gbi_ptr(image_ptr);
@@ -227 +254 @@
-    o->image_ptr = image_ptr;
+    o->image_ptr = pc_gx_resolve_gbi_ptr(image_ptr);
@@ -851 +878 @@
-    o->data = lut;
+    o->data = pc_gx_resolve_gbi_ptr(lut);
diff --git a/pc/src/pc_main.c b/pc/src/pc_main.c
--- a/pc/src/pc_main.c
+++ b/pc/src/pc_main.c
@@ -461 +461,3 @@
-        /* macOS: use dladdr — no ELF headers available */
+        /* macOS: derive the exact loaded Mach-O range. A broad estimate can
+         * turn an arbitrary truncated value into a plausible but unmapped
+         * pointer during GBI recovery. */
@@ -465,3 +467,22 @@
-            /* Estimate image end — on 64-bit, seg2k0 uses threshold check
-             * instead of image range, so this is defense-in-depth only. */
-            pc_image_end = pc_image_base + 0x10000000;
+            const struct mach_header_64* header =
+                (const struct mach_header_64*)dl.dli_fbase;
+            const struct load_command* command =
+                (const struct load_command*)(header + 1);
+            intptr_t slide = _dyld_get_image_vmaddr_slide(0);
+
+            for (u32 i = 0; i < header->ncmds; i++) {
+                if (command->cmd == LC_SEGMENT_64) {
+                    const struct segment_command_64* segment =
+                        (const struct segment_command_64*)command;
+                    if (strcmp(segment->segname, SEG_PAGEZERO) != 0) {
+                        uintptr_t segment_end = (uintptr_t)slide +
+                            (uintptr_t)segment->vmaddr +
+                            (uintptr_t)segment->vmsize;
+                        if (segment_end > pc_image_end) {
+                            pc_image_end = segment_end;
+                        }
+                    }
+                }
+                command = (const struct load_command*)
+                    ((const u8*)command + command->cmdsize);
+            }
