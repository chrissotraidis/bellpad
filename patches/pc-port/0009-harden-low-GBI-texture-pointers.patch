diff --git a/pc/include/pc_gbi_ptr.h b/pc/include/pc_gbi_ptr.h
--- a/pc/include/pc_gbi_ptr.h
+++ b/pc/include/pc_gbi_ptr.h
@@ -19 +19,2 @@
 extern uintptr_t pc_image_base;
+extern uintptr_t pc_image_end;
@@ -21,0 +23,19 @@
+static inline uintptr_t pc_gbi_recover_in_range(unsigned int truncated,
+                                                uintptr_t range_begin,
+                                                uintptr_t range_end) {
+    if (range_begin == 0 || range_end <= range_begin ||
+        range_end - range_begin > (uintptr_t)0x100000000ULL) {
+        return (uintptr_t)truncated;
+    }
+
+    uintptr_t candidate = (range_begin & ~(uintptr_t)0xFFFFFFFFu) |
+                          (uintptr_t)truncated;
+    if (candidate < range_begin) {
+        candidate += (uintptr_t)0x100000000ULL;
+    }
+    if (candidate >= range_begin && candidate < range_end) {
+        return candidate;
+    }
+    return (uintptr_t)truncated;
+}
+
@@ -27,9 +46,4 @@
-    uintptr_t arena_lo32 = arena_base & 0xFFFFFFFF;
-    uintptr_t arena_hi32 = arena_base & ~(uintptr_t)0xFFFFFFFF;
-    uintptr_t arena_end_lo32 = (arena_base + 48u * 1024u * 1024u) & 0xFFFFFFFF;
-
-    if (arena_lo32 <= arena_end_lo32) {
-        /* Arena doesn't wrap in low 32 bits */
-        if (truncated >= arena_lo32 && truncated < arena_end_lo32) {
-            return arena_hi32 | (uintptr_t)truncated;
-        }
+    uintptr_t recovered = pc_gbi_recover_in_range(
+        truncated, arena_base, arena_base + 48u * 1024u * 1024u);
+    if (recovered != (uintptr_t)truncated) {
+        return recovered;
@@ -40,4 +55,4 @@
-    uintptr_t img_hi32 = pc_image_base & ~(uintptr_t)0xFFFFFFFF;
-    uintptr_t img_lo32 = pc_image_base & 0xFFFFFFFF;
-    if (truncated >= img_lo32) {
-        return img_hi32 | (uintptr_t)truncated;
+    recovered = pc_gbi_recover_in_range(
+        truncated, pc_image_base, pc_image_end);
+    if (recovered != (uintptr_t)truncated) {
+        return recovered;
