diff --git a/pc/src/pc_settings.c b/pc/src/pc_settings.c
--- a/pc/src/pc_settings.c
+++ b/pc/src/pc_settings.c
@@ -32 +32 @@
-    "# Max FPS: 60, 120, 180, 240, or 0 for unlimited\n"
+    "# Simulation rate is fixed at the native 60 Hz cadence\n"
@@ -78,3 +78,3 @@
-        if (val == 0 || val == 60 || val == 120 || val == 180 || val == 240) {
-            g_pc_settings.max_fps = val;
-        }
+        /* The game advances simulation once per presented frame. Values above
