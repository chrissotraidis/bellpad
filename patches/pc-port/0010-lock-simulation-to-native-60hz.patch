diff --git a/pc/src/pc_main.c b/pc/src/pc_main.c
--- a/pc/src/pc_main.c
+++ b/pc/src/pc_main.c
@@ -228,8 +228,0 @@
-static void pc_speedhack_toggle(void) {
-    g_pc_fast_forward ^= 1;
-
-    if (g_pc_verbose) {
-        printf("[PC] fast-forward %s\n", g_pc_fast_forward ? "on (2x)" : "off");
-    }
-}
-
@@ -304,11 +296,3 @@
-                if (event.key.keysym.sym == SDLK_F3 && !event.key.repeat) {
-                if (!event.key.repeat) {
-                    pc_pad_queue_scancode(event.key.keysym.scancode);
-                }
-                    pc_speedhack_toggle();
-                    break;
-                }
-                if (event.key.keysym.sym == SDLK_F4 && !event.key.repeat) {
-                    g_pc_fast_forward ^= 1;
