@@ -400,5 +383,8 @@
-                if (v > 0) {
-                    g_pc_settings.max_fps = v;
-
-
+                if (v == 60) {
+                    g_pc_settings.max_fps = 60;
+                } else {
+                    fprintf(stderr,
+                            "Only --framelimit 60 is supported: higher or "
